<Window x:Class="BetterGhub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterGhub" Icon="/Assets/icon-256.png" Width="1320" Height="840" MinWidth="1040" MinHeight="680"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Rail ── -->
        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="RailPanel" Margin="16,0,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="64" VerticalAlignment="Center">
                    <Image Source="/Assets/icon-256.png" Width="32" Height="32" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="Wordmark" Text="BetterGhub" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18"
                               VerticalAlignment="Center" Margin="11,0,0,1"/>
                </StackPanel>

                <!-- Connection card -->
                <Button x:Name="CompactStatus" DockPanel.Dock="Bottom" Style="{StaticResource GhostBtn}" Visibility="Collapsed" Padding="0" Height="44" Click="CompactStatusClick">
                    <Ellipse x:Name="CompactDot" Width="12" Height="12" Fill="{StaticResource Faint}"/>
                </Button>
                <Border x:Name="ConnectionCard" DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="12" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusTitle" Text="Disconnected" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Body}" FontSize="12" Margin="18,4,0,12" Text="Mouse not connected"/>
                        <Button x:Name="ConnectButton" Style="{StaticResource PrimaryBtn}" Content="Connect mouse" Click="ConnectClick"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Nav" Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE962;" Content="Assignments" AutomationProperties.Name="Assignments" x:Name="NavAssignments" Checked="NavChecked"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Macros" AutomationProperties.Name="Macros" x:Name="NavMacros" Checked="NavChecked"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEC4A;" Content="Sensitivity" AutomationProperties.Name="Sensitivity" x:Name="NavSensitivity" Checked="NavChecked"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71D;" Content="Profiles" AutomationProperties.Name="Profiles" x:Name="NavProfiles" Checked="NavChecked"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" AutomationProperties.Name="Settings" x:Name="NavSettings" Checked="NavChecked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Main ── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="2">
                <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="MinimizeClick" ToolTip="Minimize"/>
                <Button Style="{StaticResource CaptionBtn}" x:Name="MaxButton" Content="&#xE922;" Click="MaximizeClick" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="CloseClick" ToolTip="Close"/>
            </StackPanel>

            <Grid Margin="36,22,36,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="G502 X LIGHTSPEED" Style="{StaticResource Overline}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="Assignments"/>
                </StackPanel>

                <!-- Profile picker -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="GShiftBadge" Background="{StaticResource WarningDim}" CornerRadius="7" Padding="10,5" Margin="0,0,12,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="G-SHIFT" Foreground="{StaticResource Warning}" FontWeight="Bold" FontSize="11.5"/>
                    </Border>
                    <ToggleButton x:Name="ProfileToggle" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="ProfileToggleClick">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,8" MinWidth="280">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource Muted}" Margin="14,0,0,0"/>
                            <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Surface2}" Margin="0,0,11,0">
                                <ContentControl x:Name="ProfileIcon" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileKind" Text="DESKTOP" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="ProfileName" Text="Default" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                        </DockPanel>
                    </ToggleButton>
                    <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileToggle}" Placement="Bottom" VerticalOffset="6"
                           StaysOpen="False" AllowsTransparency="True" Closed="ProfilePopupClosed">
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="10"
                                Padding="6" MinWidth="{Binding ActualWidth, ElementName=ProfileToggle}">
                            <StackPanel x:Name="ProfileList"/>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="10"
                Padding="16,10" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontWeight="SemiBold" MaxWidth="640" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
